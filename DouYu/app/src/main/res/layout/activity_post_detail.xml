<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingBottom="118dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="130dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/post_cover_frame"
                        android:layout_width="match_parent"
                        android:layout_height="255dp"
                        android:background="@drawable/bg_thumb_petal">

                        <ImageView
                            android:id="@+id/post_cover_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="作品封面"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/post_image_count"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_pill_stop"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="0/0"
                            android:textColor="#FFB84D3F"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/post_cover_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="作品图片集合 / 轮播 / 图片失败态"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="14sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="42dp"
                            android:layout_height="20dp"
                            android:background="@drawable/bg_thumb_petal" />

                        <View
                            android:layout_width="42dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_thumb_mint" />

                        <View
                            android:layout_width="42dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_thumb_sky" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/post_detail_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/doyu_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="详情顺序遵循 Open Design：作品图片集合、正文信息、作者状态、话题和互动数据。无数据时展示空态或错误态。"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip_plain"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="# 话题"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_pill_ok"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="关联图纸"
                            android:textColor="#FF237D65"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="评论区"
                        android:textColor="@color/doyu_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="评论列表、图片评论、@ 用户、# 话题和贴纸必须来自接口；接口为空时展示评论空态。"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_warning_band"
                        android:padding="12dp"
                        android:text="还没有评论。登录后可以留下拼豆建议或材料清单。"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_gravity="bottom"
            android:background="@color/doyu_page"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="78dp"
                android:layout_weight="1"
                android:background="@drawable/bg_floating_bar"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input_line"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="写下你的评论；无文字和图片时禁用发送"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="图"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="@"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="#"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/post_detail_back_to_feed"
                android:layout_width="74dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:text="返回"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
