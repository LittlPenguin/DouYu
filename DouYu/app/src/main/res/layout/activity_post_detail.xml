<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/post_detail_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="230dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="240dp">

                <TextView
                    android:id="@+id/post_detail_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_warning_band"
                    android:padding="12dp"
                    android:text="正在加载作品详情"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/post_gallery_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/post_gallery_frame"
                        android:layout_width="match_parent"
                        android:layout_height="255dp"
                        android:background="@drawable/bg_thumb_petal">

                        <ImageView
                            android:id="@+id/post_gallery_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="作品图片"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/post_gallery_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="28dp"
                            android:text="作品图片集合"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/post_carousel_count"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_pill_stop"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="0/0"
                            android:textColor="#FFB84D3F"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/post_gallery_prev"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_icon_button"
                            android:contentDescription="上一张"
                            android:gravity="center"
                            android:text="&lt;"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/post_gallery_next"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_icon_button"
                            android:contentDescription="下一张"
                            android:gravity="center"
                            android:text="&gt;"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_input_line"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="左右滑动查看作品图片"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/post_thumbnail_strip"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/post_content_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/post_author_avatar"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_round_icon"
                            android:gravity="center"
                            android:text="豆"
                            android:textColor="@color/doyu_petal_deep"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_author_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="豆友"
                                android:textColor="@color/doyu_text"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/post_author_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="作品详情"
                                android:textColor="@color/doyu_text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/post_author_follow"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_pill_ok"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="未关注"
                            android:textColor="#FF237D65"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/post_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="未命名作品"
                        android:textColor="@color/doyu_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="暂无正文"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/post_topic_chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/post_comment_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_state_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/post_comments_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="评论 0"
                            android:textColor="@color/doyu_text"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="最新"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/post_comment_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="正在加载评论"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/post_comments_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/post_comment_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_warning_band"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:padding="14dp"
                        android:text="还没有评论。登录后可以留下拼豆建议或材料清单。"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/post_comment_error_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_warning_band"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/post_comment_error_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="评论加载失败，请重试"
                            android:textColor="@color/doyu_text_muted"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/post_comment_retry"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="重新加载"
                            android:textAllCaps="false"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/post_comment_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/doyu_page"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_floating_bar"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/post_static_comment_row"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/post_static_comment_trigger"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_line"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="写下你的评论"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/post_like_action"
                        android:layout_width="48dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="点赞\n0"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_comment_action"
                        android:layout_width="48dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="评论\n0"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_favorite_action"
                        android:layout_width="48dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="收藏\n0"
                        android:textColor="@color/doyu_text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/post_comment_overlay_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/doyu_page"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/post_comment_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_floating_bar"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/post_comment_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input_line"
                    android:gravity="top|start"
                    android:hint="写下你的评论"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:minLines="2"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:id="@+id/post_comment_chip_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/post_comment_chip_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <HorizontalScrollView
                    android:id="@+id/post_comment_media_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/post_comment_media_strip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/post_comment_tool_image"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="图"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_comment_tool_mention"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="@"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/post_comment_tool_topic"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_icon"
                        android:gravity="center"
                        android:text="#"
                        android:textColor="@color/doyu_petal_deep"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/post_comment_send"
                        android:layout_width="82dp"
                        android:layout_height="38dp"
                        android:enabled="false"
                        android:text="发送"
                        android:textAllCaps="false"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
