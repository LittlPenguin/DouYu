<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/notification_detail_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/notification_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notification_detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="边界&#10;通知详情不承载聊天输入，不展示私信剩余条数，也不伪装可回复系统通知。"
                android:textColor="@color/doyu_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
