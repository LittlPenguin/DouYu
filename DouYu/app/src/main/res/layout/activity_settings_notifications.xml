<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_state_card"
                android:lineSpacingExtra="3dp"
                android:padding="16dp"
                android:text="通知偏好保存到后端；关闭提醒不删除消息页历史记录。"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_notifications_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:text="正在读取通知偏好"
                android:textColor="@color/doyu_text_muted"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/settings_notify_messages"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:buttonTint="@color/doyu_petal_deep"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="私信提醒"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/settings_notify_interactions"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:buttonTint="@color/doyu_petal_deep"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@ 提及、评论、点赞收藏"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/settings_notify_publish"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:buttonTint="@color/doyu_petal_deep"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="发布结果提醒"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/settings_notify_system"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:buttonTint="@color/doyu_petal_deep"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="系统与账号提醒"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="私信提醒只控制提醒偏好，不改变互关或发送限制。"
                android:textColor="@color/doyu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
