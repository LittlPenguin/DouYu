<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/product_image"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_image_placeholder"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/product_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/doyu_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/product_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/doyu_petal_deep"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/product_detail_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/product_trade_boundary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/purchase_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="购买"
                    android:textColor="@color/doyu_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/purchase_sku_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/purchase_form_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="数量"
                            android:textColor="@color/doyu_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/purchase_quantity_decrease"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:minWidth="0dp"
                            android:text="-"
                            android:textAllCaps="false"
                            android:textColor="@color/doyu_petal_deep"
                            android:textSize="18sp"
                            app:strokeColor="@color/doyu_open_line" />

                        <TextView
                            android:id="@+id/purchase_quantity_value"
                            android:layout_width="48dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="0"
                            android:textColor="@color/doyu_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/purchase_quantity_increase"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:minWidth="0dp"
                            android:text="+"
                            android:textAllCaps="false"
                            android:textColor="@color/doyu_petal_deep"
                            android:textSize="18sp"
                            app:strokeColor="@color/doyu_open_line" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/address_recipient_input"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_line"
                        android:hint="收货人"
                        android:inputType="textPersonName"
                        android:maxLength="40"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/doyu_text"
                        android:textColorHint="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/address_phone_input"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_line"
                        android:hint="手机号"
                        android:inputType="phone"
                        android:maxLength="30"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/doyu_text"
                        android:textColorHint="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/address_region_input"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_line"
                        android:hint="所在地区"
                        android:inputType="textCapWords"
                        android:maxLength="80"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/doyu_text"
                        android:textColorHint="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/address_detail_input"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_line"
                        android:gravity="top"
                        android:hint="收货地址"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="160"
                        android:padding="14dp"
                        android:textColor="@color/doyu_text"
                        android:textColorHint="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/order_remark_input"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_line"
                        android:hint="订单备注（选填）"
                        android:inputType="textCapSentences"
                        android:maxLength="120"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/doyu_text"
                        android:textColorHint="@color/doyu_text_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_to_cart_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="加入购物车"
                            android:textAllCaps="false"
                            android:textColor="@color/doyu_petal_deep"
                            android:textStyle="bold"
                            app:strokeColor="@color/doyu_open_line" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buy_now_button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="提交订单"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@color/doyu_petal_deep" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_cart_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="查看购物车"
                    android:textAllCaps="false"
                    android:textColor="@color/doyu_mint_deep"
                    android:textStyle="bold"
                    app:strokeColor="@color/doyu_open_line" />

                <TextView
                    android:id="@+id/purchase_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_warning_band"
                    android:padding="12dp"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
