<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="@drawable/bg_image_placeholder"
                android:gravity="center"
                android:text="上传图片生成拼豆图纸"
                android:textColor="@color/doyu_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ai_uploaded_file_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_job_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ai_pattern_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:textColor="@color/doyu_text"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="参数、进度、结果和历史都以真实任务状态为准。失败、内容安全拦截、排队中和生成中都需要明确状态，不生成本地假结果。"
                android:textColor="@color/doyu_text_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_open_camera"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="打开相机"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
