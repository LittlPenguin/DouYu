<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/photo_viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101012"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/photo_viewer_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/photo_viewer_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0/0"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/photo_viewer_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="作品大图"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/photo_viewer_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="上一张"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="@color/doyu_text_muted"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photo_viewer_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="下一张"
            android:gravity="center"
            android:text="&gt;"
            android:textColor="@color/doyu_text_muted"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/photo_viewer_thumb_strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
