<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cart_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/cart_loading"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center" />

                <TextView
                    android:id="@+id/cart_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:padding="20dp"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="收货信息"
                    android:textColor="@color/doyu_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/cart_address_recipient_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_input_line"
                    android:hint="收货人"
                    android:inputType="textPersonName"
                    android:maxLength="40"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/cart_address_phone_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_line"
                    android:hint="手机号"
                    android:inputType="phone"
                    android:maxLength="30"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/cart_address_region_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_line"
                    android:hint="所在地区"
                    android:inputType="textCapWords"
                    android:maxLength="80"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/cart_address_detail_input"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_line"
                    android:gravity="top"
                    android:hint="收货地址"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="160"
                    android:padding="14dp"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/cart_order_remark_input"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_line"
                    android:hint="订单备注（选填）"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/doyu_text"
                    android:textColorHint="@color/doyu_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/cart_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已选 0 件 - --"
                    android:textColor="@color/doyu_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cart_checkout_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="提交订单"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@color/doyu_petal_deep" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cart_retry_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="重试"
                    android:textAllCaps="false"
                    android:textColor="@color/doyu_petal_deep"
                    android:visibility="gone"
                    app:strokeColor="@color/doyu_open_line" />

                <TextView
                    android:id="@+id/cart_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_warning_band"
                    android:padding="12dp"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
