<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_state_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_pill_warn"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="开发态结构"
                    android:textColor="@color/doyu_warn"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="账号与应用设置"
                    android:textColor="@color/doyu_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="只展示可解释入口。危险操作必须二次确认，不使用轻 Toast 假成功。"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_account_security"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="账号与安全&#10;邮箱、登录设备、退出登录、注销账号"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_privacy_permissions"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="隐私与权限&#10;相机、相册、通知、位置权限"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_notifications"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="通知设置&#10;私信、评论、点赞收藏和系统通知分组控制"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_about_compliance"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="帮助、关于与合规&#10;协议、隐私政策、SDK 清单、备案和版权投诉"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_future_capability"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="未来能力 UI-only&#10;地图 API、真实支付 API、大模型生图 API"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_logout_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_stop"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="退出登录"
                android:textColor="@color/doyu_danger"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_warning_band"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="合规资料入口存在不等于资料已齐。每个入口必须进入子页面、弹确认或展示禁用说明；不能只有 Toast。"
                android:textColor="@color/doyu_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
