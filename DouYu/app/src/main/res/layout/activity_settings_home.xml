<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_state_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_pill_warn"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="&#35774;&#32622;"
                    android:textColor="@color/doyu_warn"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="&#36134;&#21495;&#19982;&#24212;&#29992;&#35774;&#32622;"
                    android:textColor="@color/doyu_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="&#20445;&#30041;&#21487;&#29992;&#30340;&#36134;&#21495;&#12289;&#26435;&#38480;&#12289;&#36890;&#30693;&#21644;&#24110;&#21161;&#20837;&#21475;&#12290;"
                    android:textColor="@color/doyu_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_account_security"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="&#36134;&#21495;&#19982;&#23433;&#20840;&#10;&#37038;&#31665;&#12289;&#30331;&#24405;&#12289;&#36864;&#20986;&#30331;&#24405;&#21644;&#36134;&#21495;&#29366;&#24577;"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_privacy_permissions"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="&#26435;&#38480;&#10;&#30456;&#26426;&#12289;&#30456;&#20876;&#21644;&#36890;&#30693;&#25480;&#26435;&#29366;&#24577;"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_notifications"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="&#36890;&#30693;&#35774;&#32622;&#10;&#31169;&#20449;&#12289;&#35780;&#35770;&#12289;&#28857;&#36190;&#25910;&#34255;&#21644;&#31995;&#32479;&#36890;&#30693;"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_help_about"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="&#24110;&#21161;&#19982;&#20851;&#20110;&#10;&#24212;&#29992;&#29256;&#26412;&#12289;&#32852;&#31995;&#26041;&#24335;&#21644;&#29256;&#26435;&#35828;&#26126;"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_logout_action"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_stop"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="&#36864;&#20986;&#30331;&#24405;"
                android:textColor="@color/doyu_danger"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
