<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/search_result_image"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/search_result_type"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:background="@drawable/bg_chip_plain"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:textColor="@color/doyu_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/search_result_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/doyu_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/search_result_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/doyu_text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
