<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/doyu_page"
    android:orientation="vertical">

    <include layout="@layout/include_page_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="豆屿 Doyu / 开发版&#10;当前是 Java/XML 迁移和主链路展示收敛阶段。"
                android:textColor="@color/doyu_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="生产前待补&#10;隐私政策、用户协议、SDK 清单和权限说明、ICP备案 / 应用市场材料、版权投诉和未成年人保护。"
                android:textColor="@color/doyu_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="禁止文案&#10;不得出现“已完成备案”“隐私政策已上线”“支付/AI/地图服务已可用”等生产完成态。"
                android:textColor="@color/doyu_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
