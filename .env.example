# 豆屿 Doyu 本地开发环境模板。
# 使用方式：复制为仓库根目录 `.env`，再按当前电脑网络环境修改。
#
# PowerShell:
#   Copy-Item .env.example .env -Force
#
# 重要规则：
# - `.env` 是本地私有文件，不提交。
# - `.env.example` 只能放模板值、示例 IP 和空密钥，不能放真实 AccessKey、Token、证书或个人路径。
# - 当前项目优先使用 Android 真机联调；模拟器只作为临时兜底，不维护独立 `.env.emulator` 模板。
# - 修改 `.env` 后必须重启后端，并重新构建 / 安装 Android debug 包。

# =========================
# 1. 当前推荐联调拓扑
# =========================

# 当前用户指定的无线真机调试目标 IP。
# 当前 Android Gradle 和 Spring Boot 不直接读取它。
DOUYU_ANDROID_TEST_DEVICE_IP=10.64.241.158

# 当前开发机在同一 Wi-Fi / LAN 下的 IPv4。
# 真机访问后端时必须写“电脑 IP”，不是手机 IP。
# 示例：电脑 IP 为 192.168.1.100，则 Android 访问 http://192.168.1.100:8081/。
DOUYU_BACKEND_HOST=192.168.1.100

# Spring Boot 后端端口。默认 8081。
DOUYU_BACKEND_PORT=8081

# 后端监听地址。真机联调必须使用 0.0.0.0，否则手机无法访问电脑上的服务。
DOUYU_SERVER_ADDRESS=0.0.0.0

# =========================
# 2. Android debug 网络配置
# =========================

# Android debug Retrofit Base URL。
# 必须以 `/` 结尾；值会在 Gradle 构建期写入 BuildConfig.API_BASE_URL。
DOUYU_ANDROID_API_BASE_URL=http://192.168.1.100:8081/

# Android debug 明文 HTTP 白名单。
# 只写 host，不写协议和端口；多个 host 用英文逗号分隔。
# 真机联调至少包含电脑当前 Wi-Fi/LAN IPv4；localhost 仅代表手机自身，不代表电脑。
DOUYU_ANDROID_CLEARTEXT_HOSTS=192.168.1.100,localhost

# =========================
# 3. 后端资源 / 上传访问地址
# =========================

# 后端 Local OSS 返回给 Android 的资源访问 Base URL。
# 真机联调时同样必须写电脑 IP，不能写 localhost。
DOUYU_STORAGE_BASE_URL=http://192.168.1.100:8081

# =========================
# 4. 对象存储 Provider
# =========================

# 对象存储 Provider。
# local：普通本地开发推荐值，文件保存在后端本地目录并由后端返回 URL。
# stub：仅用于接口联调占位。
# aliyun：只允许在本机私有 `.env` 中启用，并填入真实凭据；不要提交真实值。
DOUYU_OSS_PROVIDER=local

# Aliyun OSS Provider 模板值。
# Android 永远不保存 OSS 密钥；客户端只使用后端签发的 uploadUrl 上传。
DOUYU_ALIYUN_OSS_ENDPOINT=https://oss-cn-guangzhou.aliyuncs.com
DOUYU_ALIYUN_OSS_REGION=cn-guangzhou
DOUYU_ALIYUN_OSS_BUCKET=
DOUYU_ALIYUN_OSS_ACCESS_KEY_ID=
DOUYU_ALIYUN_OSS_ACCESS_KEY_SECRET=
DOUYU_ALIYUN_OSS_PUBLIC_BASE_URL=

# =========================
# 5. Release 占位
# =========================

# Release 构建必须使用 HTTPS。这里是占位值，不代表生产地址已经完成。
DOUYU_ANDROID_RELEASE_API_BASE_URL=https://api.example.invalid/

# =========================
# 6. 真机与模拟器规则
# =========================

# 真机优先：
# - 默认验收设备为用户指定真机 IP `10.64.241.158` 对应的无线 ADB 在线设备；实际 serial 以 `adb devices -l` 为准。
# - 可用 DOUYU_ANDROID_TEST_DEVICE_IP=10.64.241.158 记录人工识别目标设备；构建不读取它。
# - 无线调试端口、配对码和一次性连接信息不得写入文档或提交记录。
# - 后端 Host 必须写电脑 IP，例如 192.168.1.100。
# - 手机和电脑必须在同一局域网，Windows 防火墙需要放行 8081。
#
# 模拟器兜底：
# - Android 模拟器访问宿主机通常使用 10.0.2.2。
# - 如果临时使用模拟器，把 DOUYU_BACKEND_HOST / DOUYU_ANDROID_API_BASE_URL /
#   DOUYU_STORAGE_BASE_URL 改到 10.0.2.2，并把 10.0.2.2 加入
#   DOUYU_ANDROID_CLEARTEXT_HOSTS。
# - 改完后仍然必须重新构建 debug 包。
