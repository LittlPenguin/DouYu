# Copy this file to .env in the repository root, then adjust the host for
# your current development machine.
#
# Real Android phone: use the computer's current Wi-Fi/LAN IPv4 address.
# Android emulator: set DOUYU_ANDROID_API_BASE_URL to http://10.0.2.2:8081/.

DOUYU_BACKEND_HOST=192.168.1.100
DOUYU_BACKEND_PORT=8081
DOUYU_SERVER_ADDRESS=0.0.0.0

# Android debug API base URL. Retrofit requires a trailing slash.
DOUYU_ANDROID_API_BASE_URL=http://192.168.1.100:8081/

# Debug-only HTTP allowlist. Keep release/main HTTPS-only.
DOUYU_ANDROID_CLEARTEXT_HOSTS=192.168.1.100,10.0.2.2,localhost

# Backend Local OSS upload/asset URL returned to the Android client.
DOUYU_STORAGE_BASE_URL=http://192.168.1.100:8081

# Release builds should use HTTPS.
DOUYU_ANDROID_RELEASE_API_BASE_URL=https://api.example.invalid/
