# Committed template only. Copy this file into local private templates or .env,
# then adjust the host for your current development machine.
#
# .env is the only active file read by the backend start script and Android
# debug Gradle build. .env and .env.* are git-ignored; do not commit real IPs,
# secrets, tokens, or local machine paths.
#
# Optional two-template workflow:
#   Copy-Item .env.example .env.emulator
#   Copy-Item .env.example .env.phone
#   Copy-Item .env.emulator .env -Force
#   Copy-Item .env.phone .env -Force
#
# Android emulator values:
#   DOUYU_BACKEND_HOST=10.0.2.2
#   DOUYU_ANDROID_API_BASE_URL=http://10.0.2.2:8081/
#   DOUYU_STORAGE_BASE_URL=http://10.0.2.2:8081
#
# Real Android phone values:
#   Use the computer's current Wi-Fi/LAN IPv4 address, for example
#   http://192.168.1.100:8081/.
#
# After switching .env, restart the backend and rebuild the debug APK because
# Android BuildConfig.API_BASE_URL is generated at build time.

DOUYU_BACKEND_HOST=192.168.1.100
DOUYU_BACKEND_PORT=8081
DOUYU_SERVER_ADDRESS=0.0.0.0

# Android debug API base URL. Retrofit requires a trailing slash.
DOUYU_ANDROID_API_BASE_URL=http://192.168.1.100:8081/

# Debug-only HTTP allowlist. Keep release/main HTTPS-only.
DOUYU_ANDROID_CLEARTEXT_HOSTS=192.168.1.100,10.0.2.2,localhost

# Backend Local OSS upload/asset URL returned to the Android client.
DOUYU_STORAGE_BASE_URL=http://192.168.1.100:8081

# Release builds should use HTTPS.
DOUYU_ANDROID_RELEASE_API_BASE_URL=https://api.example.invalid/
